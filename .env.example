# QuantForge local configuration. Copy to .env:  cp .env.example .env
# Then generate real secrets:                   ./scripts/gen-secrets.sh
# Every service validates its config at startup and refuses to start if something is missing.

# --- Postgres (superuser only used by the init script) ---
POSTGRES_PASSWORD=change-me-postgres
QF_MIGRATOR_PASSWORD=change-me-migrator
QF_APP_PASSWORD=change-me-app
QF_WORKER_PASSWORD=change-me-worker
QF_DISPATCHER_PASSWORD=change-me-dispatcher

# --- Host ports (change if something else on your machine already uses them) ---
POSTGRES_HOST_PORT=5432
PGBOUNCER_HOST_PORT=6432
REDIS_QUEUE_HOST_PORT=6379
REDIS_CACHE_HOST_PORT=6380
API_HOST_PORT=3000
QUANT_API_HOST_PORT=8000
WEB_HOST_PORT=5173

# --- API (NestJS) ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Shared secret NestJS uses to call the internal quant API. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-internal-token-at-least-32-chars
WEB_ORIGIN=http://localhost:5173
# Set to true only behind HTTPS
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Phase 8 (not used yet) ---
# ANTHROPIC_API_KEY=

# --- Connection URLs for running apps on the host (docker compose overrides these) ---
APP_DATABASE_URL=postgresql://qf_app:${QF_APP_PASSWORD}@localhost:${PGBOUNCER_HOST_PORT}/quantforge
WORKER_DATABASE_URL=postgresql://qf_worker:${QF_WORKER_PASSWORD}@localhost:${PGBOUNCER_HOST_PORT}/quantforge
# The dispatcher uses LISTEN/NOTIFY, which needs a direct (non-PgBouncer) connection.
DISPATCHER_DATABASE_URL=postgresql://qf_dispatcher:${QF_DISPATCHER_PASSWORD}@localhost:${POSTGRES_HOST_PORT}/quantforge
REDIS_QUEUE_URL=redis://localhost:${REDIS_QUEUE_HOST_PORT}/0
REDIS_CACHE_URL=redis://localhost:${REDIS_CACHE_HOST_PORT}/0
QUANT_API_URL=http://localhost:${QUANT_API_HOST_PORT}
