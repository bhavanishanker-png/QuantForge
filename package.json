{
  "name": "quantforge",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "infra:up": "docker compose up -d --wait postgres pgbouncer redis-queue redis-cache",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @quantforge/api",
    "dev:api": "npm run start:dev -w @quantforge/api",
    "dev:web": "npm run dev -w @quantforge/web",
    "openapi": "npm run openapi:export -w @quantforge/api && npm run generate -w @quantforge/api-client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
