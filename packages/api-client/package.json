{
  "name": "@quantforge/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the QuantForge API, GENERATED from apps/api/openapi.json (ADR-001). Do not edit src/schema.d.ts by hand.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
