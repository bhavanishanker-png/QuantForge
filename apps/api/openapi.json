  "info": {
    "title": "QuantForge API",
    "description": "Public REST API. Generated from NestJS DTOs; the source of truth for client types (ADR-001).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "qf_refresh"
      },
      "workspace": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Workspace-Id",
        "description": "Selected workspace UUID"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "example": "Ada Lovelace"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Access token lifetime in seconds"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "WorkspaceRole": {
        "type": "string",
        "enum": [
          "OWNER",
          "ADMIN",
          "DEVELOPER",
          "VIEWER"
        ],
        "description": "The caller's role"
      },
      "WorkspaceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "description": "The caller's role",
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkspaceRole"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "createdAt"
        ]
      },
      "WorkspacePageDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceDto"
            }
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "items"
        ]
      },
      "CreateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Momentum research"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Momentum research"
          }
        },
        "required": [
          "name"
        ]
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkspaceRole"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "email",
          "displayName",
          "role",
          "createdAt"
        ]
      },
      "AddMemberDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkspaceRole"
              }
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkspaceRole"
              }
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "displayName"
        ]
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "QUEUED",
          "RUNNING",
          "COMPLETED",
          "FAILED",
          "CANCELLED"
        ]
      },
      "JobDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "example": "system.ping"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobStatus"
              }
            ]
          },
          "progress": {
            "type": "number",
            "description": "0-100"
          },
          "attempt": {
            "type": "integer"
          },
          "maxAttempts": {
            "type": "integer"
          },
          "cancelRequested": {
            "type": "boolean"
          },
          "resourceType": {
            "type": "string",
            "nullable": true
          },
          "resourceId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "workspaceId",
          "type",
          "status",
          "progress",
          "attempt",
          "maxAttempts",
          "cancelRequested",
          "resourceType",
          "resourceId",
          "errorCode",
          "errorMessage",
          "result",
          "createdBy",
          "createdAt",
          "startedAt",
          "finishedAt"
        ]
      },
      "JobPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "PingJobDto": {
        "type": "object",
        "properties": {
          "durationSec": {
            "type": "number",
            "default": 3,
            "minimum": 0,
            "maximum": 60,
            "description": "Seconds the job should run"
          }
        }
      },
      "JobRefDto": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobStatus"
              }
            ]
          },
          "resourceType": {
            "type": "string",
            "nullable": true
          },
          "resourceId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          }
        },
        "required": [
          "jobId",
          "status",
          "resourceType",
          "resourceId"
        ]
      }
    }
  }
}
